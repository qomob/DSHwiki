{
  "name": "dsh-plugin-hub",
  "version": "0.1.1",
  "description": "Discover DeepSeek Harness (dsh) community plugins from inside dsh. Ships the plugin_search and plugin_info tools backed by an embedded registry snapshot and the live GitHub ecosystem.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "data",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "sync-registry": "node scripts/sync-registry.mjs",
    "build-client": "node scripts/build-client.mjs",
    "smoke": "cd smoke && node ../node_modules/@deepseek-ai/cordis/bin.js",
    "build-preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "esbuild": "^0.27.7",
    "puppeteer-core": "^25.7.0",
    "react": "18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "dsh-plugin",
    "plugin-hub",
    "plugin-discovery"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qomob/dsh.git",
    "directory": "plugin"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
